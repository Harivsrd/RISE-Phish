# RISE-Phish Configuration

# Application
APP_NAME=RISE-Phish API
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Crawler Settings
HEADLESS_BROWSER=True
CRAWLER_TIMEOUT_MS=30000
SCREENSHOTS_DIR=./temp/screenshots

# OCR Settings (tesseract / mock)
OCR_ENGINE=tesseract
TESSERACT_CMD=

# SLM Settings (mock / local / api)
SLM_BACKEND=mock
SLM_MODEL_NAME=microsoft/Phi-3-mini-4k-instruct
SLM_API_KEY=
SLM_API_URL=

# Storage & Database
SQLITE_DB_URL=sqlite:///./rise_phish.db
