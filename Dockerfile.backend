# ============================================================
# RISE-Phish Backend Dockerfile (Python 3.12 + Playwright + Tesseract OCR)
# ============================================================
FROM python:3.12-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 1. Install system utilities and Tesseract OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# 3. Install Playwright browser engine & Linux runtime dependencies
RUN playwright install --with-deps chromium

# 4. Create directories for storage volumes
RUN mkdir -p /app/data /app/temp/screenshots

# 5. Copy backend application code
COPY backend /app/backend
COPY pyproject.toml /app/

# 6. Default environment settings
ENV PYTHONPATH="/app" \
    SQLITE_DB_URL="sqlite:////app/data/rise_phish.db" \
    APP_ENV="production" \
    OCR_ENGINE="tesseract" \
    SLM_BACKEND="mock"

EXPOSE 8000

# 7. Healthcheck endpoint
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# 8. Start ASGI production server
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
